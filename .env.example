# ── EventPass environment ─────────────────────────────────────────────
# Copy to `.env` (or set in the hosting provider) and fill in real values.
# NEVER commit real secrets. Everything in this file is a placeholder.

# ── Supabase (database + auth) ─────────────────────────────────────────
# From your Supabase project dashboard → Settings → API.
# Public/anonymous key. Safe to expose to the browser (used by the public client).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Supabase service-role key (server ONLY — never expose to the browser).
# Used by server functions to verify sessions and issue roles.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Postgres (Prisma) ─────────────────────────────────────────────────
# Supabase Postgres connection string. `DATABASE_URL` is required for Prisma
# migrations & the Prisma client. If using a Supabase connection pooler, set
# DIRECT_URL to the direct (non-pooled) connection for migrations.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Redis / Upstash (rate limiting, caching, seat-hold leases) ────────
UPSTASH_REDIS_REST_URL=https://<region>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>
